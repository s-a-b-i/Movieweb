# Ignore node_modules and dependencies
node_modules/
package-lock.json
yarn.lock

# Ignore IDE/editor settings
.vscode/
.idea/
*.sublime-workspace

# Ignore system files
.DS_Store
Thumbs.db

# Ignore compiled or temporary files
*.log
*.tmp
*.cache
*.swp
*.swo

# Ignore environment variables and sensitive data
.env
.env.local
.env.development
.env.production

# Ignore images if they are not meant to be tracked
*.jpg
*.png
*.gif

# Ignore minified and built files (if using a build system)
dist/
build/
